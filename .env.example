# Leave both Supabase values empty to run in DEMO MODE (sample data saved in
# your browser only). Fill them in to run in LIVE MODE against Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated email domains allowed to sign in, without the @.
# The database enforces its own copy of this list (see app_settings in
# supabase/migrations/0001_schema.sql). Keep the two in sync.
VITE_ALLOWED_EMAIL_DOMAINS=fogarty.com

# Which sign-in buttons to show: any of google, azure (Microsoft), email
VITE_AUTH_PROVIDERS=google,azure,email
